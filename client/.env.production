# Production build — set API URL only if frontend and API are on DIFFERENT domains.
# If Node serves both (same domain), leave VITE_API_URL empty.
VITE_API_URL=https://inventory-api.fortinoacademics.com
VITE_APP_URL=https://system.nigdstock.com
VITE_VAT_RATE=15
APP_NAME=NigdStock
VITE_TUTORIAL_YOUTUBE_URL=https://www.youtube.com/watch?v=83gqImG-sS0
VITE_PLAY_STORE_URL=https://play.google.com/store/apps
VITE_APP_STORE_URL=https://apps.apple.com/

# Super admin (must match server ADMIN_SEED_*)
VITE_SUPER_ADMIN_USERNAME=admin
VITE_SUPER_ADMIN_PASSWORD=Admin@123
