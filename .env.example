NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory_management
DB_USER=root
DB_PASSWORD=secret

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECURE=false
ALLOWED_ORIGINS=*

ADMIN_SEED_FULLNAME=Super Admin
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=Admin@123
ADMIN_SEED_PHONE=251900000000

# Optional SMTP (app boots without these)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Inventory Management System
EMAIL_FROM_ADDRESS=
