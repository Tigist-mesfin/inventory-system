{
  "name": "Inventory_Management_System_Backend",
  "version": "1.0.0",
  "description": "Inventory Management System API — Node.js, Express, Sequelize",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "test": "NODE_ENV=test node --test --test-concurrency=1 tests/auth.session.test.js tests/auth.rbac.test.js tests/auth.account-deletion.test.js tests/catalog.test.js tests/ai.analytics.test.js tests/kacha.integration.test.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "node src/database/seeders/runSeed.js",
    "zip": "NAME=$(node -p \"require('./package.json').name\") && VERSION=$(node -p \"require('./package.json').version\") && zip -r \"${NAME}-v${VERSION}.zip\" . -x \"node_modules/*\" \"uploads/*\" \"doc/*\" \"docs/*\" \".*\" \"z/*\" \"*.zip\""
  },
  "keywords": [
    "inventory",
    "express",
    "sequelize"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.10",
    "morgan": "^1.11.0",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "mysql2": "^3.23.3",
    "nodemailer": "^9.0.5",
    "sequelize": "^6.37.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
